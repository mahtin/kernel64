{
  "name": "kernel64",
  "main": "index.js",
  "compatibility_date": "2024-04-01",
  "rules": [
    {
      "type": "Text",
      "globs": [
        "./kernel64logo-small.png",
        "../README.md",
        "../THEORY-OF-OPERATIONS.md",
        "../CHANGELOG.md",
        "./simple.min.css"
      ],
      "fallthrough": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  }
}
